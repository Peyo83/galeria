# Application Core Config
PROJECT_NAME="Name"
VERSION="version"
API_V1_STR="/api/v1"

# PostgreSQL Config
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=db
POSTGRES_PORT=5432

# Auth JWT Config (v1 Admin)
SECRET_KEY=secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Config
CORS_ORIGINS=["http://localhost:port","http://localhost:port"]